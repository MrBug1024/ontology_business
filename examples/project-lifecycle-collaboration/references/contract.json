{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-lifecycle-collaboration:1.0.0",
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "text": {"type":"string","minLength":1,"maxLength":12000},
    "ids": {"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "time": {"type":"string","format":"date-time","maxLength":40},
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "participant": {
      "type":"object","additionalProperties":false,
      "required":["participant_id","display_name","roles","channel_id","active"],
      "properties":{
        "participant_id":{"$ref":"#/$defs/id"},
        "display_name":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[^\\r\\n@]+$"},
        "roles":{"$ref":"#/$defs/ids"},"channel_id":{"$ref":"#/$defs/id"},"active":{"type":"boolean"}
      }
    },
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["evidence_id","text","source_ref","status"],
      "properties":{
        "evidence_id":{"$ref":"#/$defs/id"},"text":{"$ref":"#/$defs/text"},
        "source_ref":{"$ref":"#/$defs/id"},"status":{"enum":["reported","verified"]}
      }
    },
    "review": {
      "type":"object","additionalProperties":false,
      "required":["review_id","title","version","sha256"],
      "properties":{
        "review_id":{"$ref":"#/$defs/id"},"title":{"$ref":"#/$defs/text"},
        "version":{"$ref":"#/$defs/id"},"sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "context": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","project_id","context_revision","as_of","channel_id","question","stage","participants","evidence","review_contents","permitted_due_dates","consumed_decision_ids"],
      "properties":{
        "schema_version":{"const":"1.0.0"},"project_id":{"$ref":"#/$defs/id"},
        "context_revision":{"type":"integer","minimum":0},"as_of":{"$ref":"#/$defs/time"},
        "channel_id":{"$ref":"#/$defs/id"},"question":{"$ref":"#/$defs/text"},
        "stage":{"type":["string","null"],"maxLength":100},
        "participants":{"type":"array","maxItems":300,"items":{"$ref":"#/$defs/participant"}},
        "evidence":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/evidence"}},
        "review_contents":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/review"}},
        "permitted_due_dates":{"type":"array","maxItems":100,"uniqueItems":true,"items":{"$ref":"#/$defs/time"}},
        "consumed_decision_ids":{"$ref":"#/$defs/ids"}
      }
    },
    "finding": {
      "type":"object","additionalProperties":false,"required":["kind","text","evidence_ids"],
      "properties":{
        "kind":{"enum":["fact","reported","hypothesis","suggestion","unknown"]},
        "text":{"$ref":"#/$defs/text"},"evidence_ids":{"$ref":"#/$defs/ids"}
      }
    },
    "request": {
      "type":"object","additionalProperties":false,
      "required":["request_id","kind","role_key","assignee_id","summary","evidence_ids","review_id","due_at","depends_on_request_ids"],
      "properties":{
        "request_id":{"$ref":"#/$defs/id"},
        "kind":{"enum":["clarify","provide_material","review","confirm_plan","acceptance","follow_up"]},
        "role_key":{"$ref":"#/$defs/id"},
        "assignee_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
        "summary":{"type":"string","minLength":1,"maxLength":2000,"pattern":"^[^@]+$"},
        "evidence_ids":{"$ref":"#/$defs/ids"},
        "review_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
        "due_at":{"anyOf":[{"$ref":"#/$defs/time"},{"type":"null"}]},
        "depends_on_request_ids":{"$ref":"#/$defs/ids"}
      }
    },
    "analysis": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","project_id","context_revision","status","findings","pending_requests","proposed_changes","questions"],
      "properties":{
        "schema_version":{"const":"1.0.0"},"project_id":{"$ref":"#/$defs/id"},
        "context_revision":{"type":"integer","minimum":0},"status":{"const":"draft"},
        "findings":{"type":"array","maxItems":60,"items":{"$ref":"#/$defs/finding"}},
        "pending_requests":{"type":"array","maxItems":30,"items":{"$ref":"#/$defs/request"}},
        "proposed_changes":{"type":"array","maxItems":60,"items":{"$ref":"#/$defs/finding"}},
        "questions":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/text"}}
      }
    },
    "decision_request": {
      "type":"object","additionalProperties":false,
      "required":["project_id","context_revision","channel_id","request_id","actor_id","role_key","review_id","review_version","review_sha256","issued_at","expires_at","status"],
      "properties":{
        "project_id":{"$ref":"#/$defs/id"},"context_revision":{"type":"integer","minimum":0},
        "channel_id":{"$ref":"#/$defs/id"},"request_id":{"$ref":"#/$defs/id"},
        "actor_id":{"$ref":"#/$defs/id"},"role_key":{"$ref":"#/$defs/id"},
        "review_id":{"$ref":"#/$defs/id"},"review_version":{"$ref":"#/$defs/id"},"review_sha256":{"$ref":"#/$defs/sha256"},
        "issued_at":{"$ref":"#/$defs/time"},"expires_at":{"$ref":"#/$defs/time"},"status":{"enum":["pending","consumed","cancelled"]}
      }
    },
    "decision": {
      "type":"object","additionalProperties":false,
      "required":["project_id","context_revision","request_id","decision_id","actor_id","channel_id","review_version","review_sha256","outcome","decided_at","external_receipt_id"],
      "properties":{
        "project_id":{"$ref":"#/$defs/id"},"context_revision":{"type":"integer","minimum":0},
        "request_id":{"$ref":"#/$defs/id"},"decision_id":{"$ref":"#/$defs/id"},
        "actor_id":{"$ref":"#/$defs/id"},"channel_id":{"$ref":"#/$defs/id"},
        "review_version":{"$ref":"#/$defs/id"},"review_sha256":{"$ref":"#/$defs/sha256"},"outcome":{"enum":["approved","rejected","changes_requested"]},
        "decided_at":{"$ref":"#/$defs/time"},"external_receipt_id":{"$ref":"#/$defs/id"}
      }
    },
    "document": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","project_id","context_revision","title","version","status","sections","evidence","open_questions","review_notes"],
      "properties":{
        "schema_version":{"const":"1.0.0"},"project_id":{"$ref":"#/$defs/id"},
        "context_revision":{"type":"integer","minimum":0},"title":{"type":"string","minLength":1,"maxLength":120},
        "version":{"$ref":"#/$defs/id"},"status":{"const":"draft"},
        "sections":{"type":"array","minItems":1,"maxItems":30,"items":{
          "type":"object","additionalProperties":false,"required":["heading","paragraphs"],
          "properties":{
            "heading":{"type":"string","minLength":1,"maxLength":120},
            "paragraphs":{"type":"array","minItems":1,"maxItems":40,"items":{"$ref":"#/$defs/document_paragraph"}}
          }
        }},
        "evidence":{"type":"array","maxItems":200,"items":{"$ref":"#/$defs/evidence"}},
        "open_questions":{"type":"array","maxItems":60,"items":{"$ref":"#/$defs/text"}},
        "review_notes":{"type":"array","maxItems":60,"items":{"$ref":"#/$defs/text"}}
      }
    },
    "document_paragraph": {
      "type":"object","additionalProperties":false,"required":["kind","text","evidence_ids"],
      "properties":{
        "kind":{"enum":["evidence","suggestion","question"]},
        "text":{"anyOf":[{"$ref":"#/$defs/text"},{"type":"null"}]},
        "evidence_ids":{"$ref":"#/$defs/ids"}
      },
      "allOf":[
        {"if":{"properties":{"kind":{"const":"evidence"}}},
         "then":{"properties":{"text":{"type":"null"},"evidence_ids":{"minItems":1}}},
         "else":{"properties":{"text":{"$ref":"#/$defs/text"}}}}
      ]
    }
  }
}
