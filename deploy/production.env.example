# Set these values in Coolify/your secret manager. Do not commit a populated
# production env file or encode GitHub credentials in a repository URL.
# Optional explicit URI overrides. Leave blank to derive safely from
# POSTGRESQL_* (and POSTGRESQL_ADMIN_* for the migration container).
DATABASE_URL=
ALEMBIC_DATABASE_URL=
ALEMBIC_USE_ADMIN=1
POSTGRESQL_HOST=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=ontology_platform
POSTGRESQL_USER=ontology_app
POSTGRESQL_PASSWORD=replace-me
POSTGRESQL_ADMIN_USER=ontology_migrator
POSTGRESQL_ADMIN_PASSWORD=replace-me
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
WORKER_DATABASE_POOL_SIZE=3
WORKER_DATABASE_MAX_OVERFLOW=3
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=120000
DATABASE_LOCK_TIMEOUT_MS=10000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ALIYUN_ENDPOINT=https://minio.example.com
MINIO_ALIYUN_ACCESS_KEY_ID=replace-me
MINIO_ALIYUN_ACCESS_KEY_SECRET=replace-me
MINIO_ALIYUN_FILE_PATH=ontology-business/
MINIO_BUCKETNAME=ontology-business
MINIO_REQUEST_TIMEOUT_SECONDS=20
MINIO_UPLOAD_INTENT_TIMEOUT_SECONDS=3600
MINIO_LATE_PUT_CLEANUP_GRACE_SECONDS=600

# OCR is required for image parsing and recommended for production PDF parsing.
OCR_BASE_URL=https://ocr.example.com
OCR_API_KEY=replace-me

MAIL_SERVER=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=replace-me@example.com
MAIL_PASSWORD=replace-me
MAIL_FROM=replace-me@example.com
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
MAIL_USE_CREDENTIALS=true
MAIL_TIMEOUT_SECONDS=20
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_LOCK_MINUTES=30

AGENT_MCP_PUBLIC_URL=https://api.example.com/mcp
AGENT_MCP_ALLOWED_HOSTS=api.example.com
# Shared by all API workers; generate a distinct high-entropy value in the
# production secret manager. It signs server-issued MCP transport sessions.
AGENT_MCP_SESSION_SIGNING_KEY=replace-with-random-secret
AGENT_MCP_REQUIRE_HOST_CONTEXT=true
AGENT_MCP_TURN_LEASE_SECONDS=90
AGENT_MCP_TURN_WAIT_SECONDS=30
AGENT_MCP_TURN_MAX_SECONDS=900
API_WORKERS=3
BACKGROUND_WORKER_POLL_SECONDS=1
ASSISTANT_RECOVERY_POLL_SECONDS=10
# This must cover the configured MinIO read timeout and its bounded retry.
# Raise it with MINIO_REQUEST_TIMEOUT_SECONDS when that value exceeds 20.
API_HEALTHCHECK_INTERVAL=30s
API_HEALTHCHECK_TIMEOUT=60s
API_HEALTHCHECK_RETRIES=5
API_HEALTHCHECK_START_PERIOD=90s
WEB_PORT=8080
# Keep true behind Coolify/reverse-proxy TLS. A private HTTP-only smoke test
# may set this false temporarily; never do so on a public endpoint.
AUTH_COOKIE_SECURE=true
