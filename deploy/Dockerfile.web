FROM node:22-alpine AS build

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# The frontend is served directly by Vite preview; there is no Nginx reverse
# proxy in this deployment. Set this to the public API URL in Coolify when the
# API and frontend use different hostnames.
ARG VITE_API_BASE_URL=https://ontology-api.rhzy.ai/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM node:22-alpine

WORKDIR /app/frontend
COPY --from=build /app/frontend/package.json /app/frontend/package-lock.json ./
RUN apk add --no-cache curl
COPY --from=build /app/frontend/node_modules ./node_modules
COPY --from=build /app/frontend/dist ./dist
# vite preview reads preview.allowedHosts at runtime, so retain the config in
# the runtime image rather than only using it during the build.
COPY --from=build /app/frontend/vite.config.ts ./vite.config.ts

# Coolify's HTTP router targets this port.  Vite preview serves the built SPA
# and binds on all interfaces inside the container.
EXPOSE 5173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
