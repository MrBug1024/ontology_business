# Copy this file to backend/.env and fill only the values required locally.
DEBUG=false
# DATABASE_URL=sqlite:///absolute/path/to/platform.db

# Optional OCR service. PDF text extraction falls back locally when no key is set.
OCR_BASE_URL=https://ocr.rhzy.ai
OCR_API_KEY=

# Agent runtime
MAX_TOOL_ROUNDS=20
MAX_QUERY_ROWS=200
LLM_TIMEOUT=120
ALLOW_UNSAFE_WORKFLOW_NODES=false
ALLOW_INSECURE_HTTP_ACTIONS=false
RUNTIME_ENVIRONMENT=dev

# Authentication cookie
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7

# Required only for email registration verification and password reset.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
MAIL_USE_CREDENTIALS=true
MAIL_TIMEOUT_SECONDS=20
