# Copy this file to backend/.env and fill only the values required locally.
DEBUG=false
# PostgreSQL is the only platform database. Use the actual service DNS/name in
# containers; 127.0.0.1 only works when PostgreSQL runs in the same host OS.
DATABASE_BACKEND=postgresql
# Optional complete URL override. When blank it is built from POSTGRESQL_*.
DATABASE_URL=
POSTGRESQL_HOST=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=ontology_platform
POSTGRESQL_USER=ontology_app
POSTGRESQL_PASSWORD=
POSTGRESQL_MAINTENANCE_DATABASE=postgres
# Optional administrative credentials for database provisioning.
POSTGRESQL_ADMIN_USER=postgres
POSTGRESQL_ADMIN_PASSWORD=

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=120000
DATABASE_LOCK_TIMEOUT_MS=10000

# Redis cache.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO object storage.
MINIO_ALIYUN_ENDPOINT=
MINIO_ALIYUN_ACCESS_KEY_ID=
MINIO_ALIYUN_ACCESS_KEY_SECRET=
MINIO_ALIYUN_FILE_PATH=ontology-business/
MINIO_BUCKETNAME=
MINIO_REQUEST_TIMEOUT_SECONDS=20
MINIO_UPLOAD_INTENT_TIMEOUT_SECONDS=3600

# Optional OCR service. PDF text extraction falls back locally when no key is set.
OCR_BASE_URL=https://ocr.rhzy.ai
OCR_API_KEY=

# Agent runtime
MAX_TOOL_ROUNDS=20
MAX_QUERY_ROWS=200
DATASET_QUERY_TIMEOUT_SECONDS=30
DATASET_QUERY_MAX_CONCURRENCY=4
DATASET_DUCKDB_MEMORY_LIMIT_BYTES=536870912
DATASET_DUCKDB_THREADS=2
# Optional absolute path; blank keeps DuckDB spill files under the private dataset cache.
DATASET_DUCKDB_TEMP_DIRECTORY=
DATASET_DUCKDB_MAX_TEMP_DIRECTORY_BYTES=1073741824
DATASET_CACHE_MAX_OBJECT_BYTES=1073741824
DATASET_CACHE_MAX_BYTES=10737418240
DATASET_CACHE_MAX_AGE_SECONDS=604800
LLM_TIMEOUT=120
SCENARIO_MODEL_LLM_TIMEOUT=600
SCENARIO_MODEL_MAX_LLM_CALLS=24
MAX_UPLOAD_BYTES=419430400
ALLOW_UNSAFE_WORKFLOW_NODES=false
ALLOW_INSECURE_HTTP_ACTIONS=false
ALLOW_MCP_STDIO=false
ALLOW_INSECURE_MCP_HTTP=false
MCP_PRIVATE_HOST_ALLOWLIST=
MCP_OPERATION_TIMEOUT_SECONDS=90
AGENT_MCP_PUBLIC_URL=
AGENT_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,testserver
# Set a random shared secret in production so all API workers can validate
# only server-issued MCP transport session ids.
AGENT_MCP_SESSION_SIGNING_KEY=
AGENT_MCP_TURN_LEASE_SECONDS=90
AGENT_MCP_TURN_WAIT_SECONDS=30
AGENT_MCP_TURN_MAX_SECONDS=900
RUNTIME_ENVIRONMENT=dev
RUN_BACKGROUND_WORKERS=true
BACKGROUND_WORKER_POLL_SECONDS=1
ASSISTANT_RECOVERY_POLL_SECONDS=10

# Authentication cookie
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
VERIFICATION_CODE_MINUTES=10
# Workspace invitations are fixed at 24 hours. Older values are accepted on
# upgrade and normalized by the application, but new deployments should use 1440.
INVITATION_CODE_MINUTES=1440
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_LOCK_MINUTES=30

# Required only for email registration verification and password reset.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
MAIL_USE_CREDENTIALS=true
MAIL_TIMEOUT_SECONDS=20
