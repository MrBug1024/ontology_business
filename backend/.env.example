# Copy this file to backend/.env and fill only the values required locally.
DEBUG=false
# PostgreSQL is the only platform database.
DATABASE_BACKEND=postgresql
POSTGRESQL_HOST=127.0.0.1
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=ontology_platform
POSTGRESQL_USER=ontology_app
POSTGRESQL_PASSWORD=
POSTGRESQL_MAINTENANCE_DATABASE=postgres
# Optional administrative credentials for database provisioning.
POSTGRESQL_ADMIN_USER=postgres
POSTGRESQL_ADMIN_PASSWORD=

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=120000
DATABASE_LOCK_TIMEOUT_MS=10000
# Exact MySQL research hostnames/IPs; no wildcard. TLS certificates must be trusted.
LIBRARY_MYSQL_ALLOWED_HOSTS=

# Redis cache.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO object storage.
MINIO_ALIYUN_ENDPOINT=
MINIO_ALIYUN_ACCESS_KEY_ID=
MINIO_ALIYUN_ACCESS_KEY_SECRET=
MINIO_ALIYUN_FILE_PATH=ontology-business/
MINIO_BUCKETNAME=
MINIO_UPLOAD_INTENT_TIMEOUT_SECONDS=3600

# Optional server-owned OCR adapter. Leave every value blank to disable remote OCR;
# Native PDF text remains available; scanned PDFs and images fail closed.
OCR_BASE_URL=
OCR_ENDPOINT_PATH=
# Comma-separated exact host names/IP literals. Private targets must appear in both lists.
OCR_ALLOWED_HOSTS=
OCR_PRIVATE_HOST_ALLOWLIST=
OCR_API_KEY=
OCR_ENGINE=
OCR_LANGUAGE=
OCR_TIMEOUT_SECONDS=600

# Optional read-only industry research adapter. The endpoint must be HTTPS and
# its exact host must appear in ASSISTANT_RESEARCH_ALLOWED_HOSTS.
ASSISTANT_RESEARCH_ENABLED=false
ASSISTANT_RESEARCH_ENDPOINT=
ASSISTANT_RESEARCH_ALLOWED_HOSTS=
ASSISTANT_RESEARCH_TIMEOUT_SECONDS=20

# Agent runtime
MAX_TOOL_ROUNDS=20
MAX_QUERY_ROWS=200
DATASET_QUERY_TIMEOUT_SECONDS=30
DATASET_QUERY_MAX_CONCURRENCY=4
DATASET_DUCKDB_MEMORY_LIMIT_BYTES=536870912
DATASET_DUCKDB_THREADS=2
# Optional absolute path; blank keeps DuckDB spill files under the private dataset cache.
DATASET_DUCKDB_TEMP_DIRECTORY=
DATASET_DUCKDB_MAX_TEMP_DIRECTORY_BYTES=1073741824
# Optional absolute path owned by the backend service account. Blank uses the OS temp cache.
DATASET_CACHE_DIRECTORY=
DATASET_CACHE_MAX_OBJECT_BYTES=1073741824
DATASET_CACHE_MAX_BYTES=10737418240
DATASET_CACHE_MAX_AGE_SECONDS=604800
LLM_TIMEOUT=120
SCENARIO_MODEL_LLM_TIMEOUT=600
SCENARIO_MODEL_MAX_LLM_CALLS=24
# Governed catalog, modelling and validation uploads are streamed to private
# staging files and MinIO. MAX_UPLOAD_BYTES remains the 50 MiB legacy ceiling.
MAX_UPLOAD_BYTES=52428800
CATALOG_MAX_UPLOAD_BYTES=2147483648
CATALOG_IN_MEMORY_UPLOAD_BYTES=8388608
UPLOAD_STREAM_CHUNK_BYTES=4194304
CATALOG_MAX_OFFICE_EXPANDED_BYTES=8589934592
DOCUMENT_PARSE_MAX_BYTES=268435456
VALIDATION_DATASET_MATERIALIZATION_TIMEOUT_SECONDS=3600
ALLOW_UNSAFE_WORKFLOW_NODES=false
# Required before enqueueing asynchronous workflows or migrating existing
# workflow_runs. Generate a 32-byte key outside the repository, keep old key ids
# during rotation, and store the JSON key ring only in the deployment secret
# manager (example shape: {"2026-q3":"<urlsafe-base64-32-byte-key>"}).
WORKFLOW_PAYLOAD_ACTIVE_KEY_ID=1234567890
WORKFLOW_PAYLOAD_ENCRYPTION_KEYS=ymtqwertfhkkl123
ALLOW_INSECURE_HTTP_ACTIONS=false
ALLOW_MCP_STDIO=false
ALLOW_INSECURE_MCP_HTTP=false
# Install Chromium with: python -m playwright install chromium
# Browser network remains separately governed by its adapter policy.
DISTILLATION_BROWSER_ENABLED=false
DISTILLATION_BROWSER_MAX_SESSIONS=2
DISTILLATION_MODEL_TIMEOUT_SECONDS=120
MCP_OPERATION_TIMEOUT_SECONDS=90
AGENT_MCP_PUBLIC_URL=
AGENT_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,testserver
# Infrastructure metadata only. Configure separate databases and services for
# local development and deployed installations; never partition business rows.
RUNTIME_ENVIRONMENT=dev

# Authentication cookie
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
# Public frontend origin used by invitations and cookie write-origin checks.
# Production: your HTTPS frontend origin, with AUTH_COOKIE_SECURE=true.
# Development accepts localhost and any frontend IP on any port, so this can
# remain empty when opening the Vite server by host IP.
PUBLIC_APP_URL=
# One-time bootstrap of a specifically chosen, verified account. Remove after use.
# No existing account is automatically selected; subsequent changes use /accounts.
BOOTSTRAP_SUPERADMIN_EMAIL=

# Required for verification, password reset and workspace invitation delivery.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
MAIL_USE_CREDENTIALS=true
MAIL_TIMEOUT_SECONDS=20
